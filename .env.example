# ATLAS local defaults are demo-only and do not contain credentials.
ATLAS_MODE=demo
ATLAS_API_BASE_URL=http://localhost:8080
VITE_API_BASE_URL=http://localhost:8080
VITE_ATLAS_API_KEY=
ATLAS_REQUIRE_AUTH=false
ATLAS_ALLOWED_ORIGINS=http://localhost:4173
ATLAS_SQLSERVER_URL=Server=localhost,1433;Database=atlas;User Id=sa;Password=CHANGE_ME;TrustServerCertificate=True
ATLAS_POSTGRES_URL=postgresql://atlas:CHANGE_ME@localhost:5432/atlas
ATLAS_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
